# Copy to .env.local for local development. In production these are set in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Supabase → Project Settings → Data API (URL) and → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The site's address, for links in emails
NEXT_PUBLIC_SITE_URL=https://eriksvoice.co.il

# Emails that become system admins on their first sign-in (comma separated)
ADMIN_EMAILS=

# Providers (next phases)
# Provider keys below are optional once set in the admin panel (Settings → Providers, stored in Supabase Vault).
ELEVENLABS_API_KEY=
# Post-call webhook secret (ElevenLabs → Agents → Settings → Webhooks; URL https://eriksvoice.co.il/api/public/voice/webhook)
ELEVENLABS_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
UTOBO_API_KEY=
ACTIVEPIECES_URL=https://voice.eriks.co.il
ACTIVEPIECES_SIGNING_SECRET=

# Vercel Cron for the call cannon (any long random string; Vercel sends it as a Bearer token)
CRON_SECRET=
