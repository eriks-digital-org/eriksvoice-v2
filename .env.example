# Copy to .env.local for local development. In production these are set in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Supabase → Project Settings → Data API (URL) and → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The site's address, for links in emails
NEXT_PUBLIC_SITE_URL=https://eriksvoice.co.il

# Emails that become system admins on their first sign-in (comma separated)
ADMIN_EMAILS=

# Providers (next phases)
ELEVENLABS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
UTOBO_API_KEY=
ACTIVEPIECES_URL=https://voice.eriks.co.il
ACTIVEPIECES_SIGNING_SECRET=
